---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"About Stavros Karelis – Computer Scientist, Machine Learning graduate, and creator of a digital garden about AI, software, and technology.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm max-w-none">
		<p>Welcome to my digital garden 🌿</p>

		<p>
			I'm <strong>Stavros Karelis</strong>, a Computer Scientist with a Master's degree in Machine
			Learning. I enjoy building software, exploring modern technologies, and sharing practical
			ideas through articles, notes, and experiments.
		</p>

		<h2>🧑‍💻 What you'll find here</h2>

		<ul class="list-inside list-disc" role="list">
			<li>🧠 Artificial Intelligence & Machine Learning</li>
			<li>💻 Software Development & Web Technologies</li>
			<li>🚀 Digital products, experiments, and side projects</li>
			<li>📒 Notes, references, and technology insights</li>
		</ul>

		<p>
			My goal is to understand how technology works and document useful knowledge that can be
			revisited and improved over time.
		</p>

		<h2>📌 About this website</h2>

		<p>
			This website is a digital garden built with Astro and Tailwind CSS. It is intentionally
			simple, fast, and focused on content.
		</p>

		<ul class="list-inside list-disc" role="list">
			<li>⚡ Fast static delivery</li>
			<li>📱 Responsive design</li>
			<li>✍️ Markdown-powered content</li>
			<li>📖 Clean, distraction-free reading</li>
		</ul>

		<p>
			Unlike a traditional blog, this is a living collection of ideas that grows and evolves over
			time.
		</p>

		<h2>📬 Contact</h2>

		<p>If you'd like to discuss, collaborate on a project, or simply say hello:</p>

		<p>
			<a href="mailto:hello@stavroskarelis.com">hello@stavroskarelis.com</a>
		</p>
	</div>
</PageLayout>
