---

<a
	href="https://buymeacoffee.com/stavroskarelis"
	target="_blank"
	rel="noopener noreferrer"
	class="coffee-widget"
	aria-label="Buy me a coffee (opens in a new tab)"
>
	<span class="coffee-icon" aria-hidden="true">
		<span class="cup"></span>
	</span>

	<span class="text">Buy me a coffee</span>
</a>

<style>
	.coffee-widget {
		position: fixed;
		right: calc(20px + env(safe-area-inset-right));
		bottom: calc(20px + env(safe-area-inset-bottom));
		z-index: 9999;

		width: 48px;
		height: 48px;

		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;

		padding: 0 16px;

		background: #fff;
		color: #222;

		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 999px;

		text-decoration: none;
		overflow: hidden;
		cursor: pointer;

		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);

		transition:
			width 0.3s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.coffee-icon {
		width: 22px;
		height: 22px;

		display: flex;
		align-items: center;
		justify-content: center;

		flex-shrink: 0;
	}

	/* Cup */

	.cup {
		position: relative;

		width: 12px;
		height: 11px;

		background: #222;
		border-radius: 2px 2px 5px 5px;
	}

	/* Coffee */

	.cup::before {
		content: "";

		position: absolute;

		top: -3px;
		left: 1px;

		width: 10px;
		height: 3px;

		background: #222;
		border-radius: 999px;
	}

	/* Handle */

	.cup::after {
		content: "";

		position: absolute;

		right: -5px;
		top: 2px;

		width: 5px;
		height: 6px;

		border: 2px solid #222;
		border-left: 0;
		border-radius: 0 6px 6px 0;
	}

	.text {
		opacity: 0;
		max-width: 0;
		overflow: hidden;
		white-space: nowrap;

		font-size: 14px;
		font-weight: 500;
		color: #222;

		transition:
			opacity 0.2s ease,
			max-width 0.3s ease;
	}

	.coffee-widget:hover,
	.coffee-widget:focus-visible {
		width: 180px;
		transform: translateY(-3px);

		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}

	.coffee-widget:hover .text,
	.coffee-widget:focus-visible .text {
		opacity: 1;
		max-width: 160px;
	}

	.coffee-widget:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	@media (hover: none) {
		.coffee-widget:hover {
			width: 48px;
			transform: none;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
		}

		.coffee-widget:hover .text {
			opacity: 0;
			max-width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.coffee-widget,
		.text {
			transition: none;
		}
	}
</style>
